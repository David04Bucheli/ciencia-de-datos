# Copia este archivo como .env y llena los valores. NUNCA subas .env a GitHub.

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=<ORGANIZACION-CUENTA>
SNOWFLAKE_USER=<TU_USUARIO>
SNOWFLAKE_ROLE=<TU_ROL>
SNOWFLAKE_WAREHOUSE=NYC_TAXI_WH
SNOWFLAKE_DATABASE=NYC_TAXI

# --- Autenticación: keypair (recomendado) | pat | password ---
SNOWFLAKE_AUTH_METHOD=keypair
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_TOKEN=
SNOWFLAKE_PASSWORD=

# --- Meses a procesar (AAAA-MM) ---
TLC_START_MONTH=2025-01
TLC_END_MONTH=2026-08

# --- Login de Kestra (http://localhost:8080) ---
# Usuario = un correo. Contraseña: 8+ caracteres, mayúscula, minúscula y número. Sin el símbolo $.
KESTRA_ADMIN_USER=admin@kestra.io
KESTRA_ADMIN_PASSWORD=Admin1234!